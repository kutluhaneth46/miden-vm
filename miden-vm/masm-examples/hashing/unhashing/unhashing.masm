# This example showcases how to "unhash" data from the advice provider; that is, how to
# read untrusted data from the advice provider, and verify that it hashes to an expected
# value. Specifically, we
# 1. Read data from the advice provider and store it simultaneously on the stack and
# 2. Compress the native hash state.

use miden::core::crypto::hashes::eidos

begin
    # Reads 100 words from the advice provider, stores them in memory, and computes their hash.
    # Bind the full 400-Felt message length into the initial Eidos chaining value.
    push.400 exec.eidos::init_chaining_word movdnw.2
    # => [BLOCK_LO=ZERO_WORD, BLOCK_HI=ZERO_WORD, CV, addr=0]

    repeat.50
        adv_pipe bcompress
    end
    # => [BLOCK_LO, BLOCK_HI, DIGEST, addr]

    # Drop the two preserved block words.
    exec.eidos::digest
    # => [DIGEST, addr]

    # Drop the memory address.
    movup.4 drop
    # => [DIGEST]
end
